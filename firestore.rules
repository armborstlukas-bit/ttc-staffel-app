rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    // ── Individuelle Nutzerprofile (/users/{uid}) ──────────────────
    // Jeder eingeloggte User darf sein eigenes Profil lesen & anlegen.
    // Update: Admins dürfen jedes Profil vollständig ändern (Rollenverwaltung).
    // Der Nutzer selbst darf sein Profil pflegen (Name, Benachrichtigungen etc.),
    // aber NICHT die privilegierten Felder (roles/role/primaryRole/linkedChildIds/
    // linkedChildId/linkedPlayerId/groupIds) selbst verändern — sonst könnte sich
    // jeder eingeloggte Nutzer per direktem Firestore-Schreibzugriff (z.B. Browser-
    // Konsole) selbst zum Admin machen und hätte damit Zugriff auf mitgliederListe/
    // mitgliederFinanzen (Bankdaten!), da isAdmin() genau dieses Feld ausliest.
    function unchangedPrivilegedFields() {
      let protectedFields = ['roles','role','primaryRole','linkedChildIds','linkedChildId','linkedPlayerId','groupIds'];
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields) == false;
    }
    match /users/{userId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == userId && unchangedPrivilegedFields())
      );
      allow delete: if isAdmin();
    }

    // ── App-Daten unter /ttc/* ─────────────────────────────────────
    // Lesen: alle eingeloggten Nutzer (Trainer, Eltern, Jugendliche)
    // Schreiben: alle eingeloggten Nutzer
    //   → Eltern/Jugendliche schreiben z.B. Turnier- & Trainingsanmeldungen
    //   → Trainer/Admins schreiben alle anderen Daten
    //   → Schutz vor unbefugtem Zugriff: nur Firebase-Auth-User
    // Ausnahme: mitgliederListe (Namen/Geburtsdaten/Rollen) und mitgliederFinanzen
    // (Adresse/Bankdaten/Beiträge) sind personenbezogen bzw. hochsensibel und daher
    // ausschließlich für Admins lesbar — siehe eigene match-Blöcke unten.
    match /ttc/{document} {
      allow read:  if request.auth != null && document != 'mitgliederListe' && document != 'mitgliederFinanzen';
      allow write: if request.auth != null && document != 'mitgliederListe' && document != 'mitgliederFinanzen';
    }

    // ── Mitgliederliste & Mitglieder-Finanzdaten: nur Admins ───────────────
    // Die automatische Rollen-Zuordnung bei der Registrierung liest diese
    // Daten NICHT mehr direkt aus dem Client, sondern über eine serverseitige
    // Funktion (Firebase Admin SDK, umgeht diese Regeln) — siehe api/mitglieder.js.
    match /ttc/mitgliederListe {
      allow read, write: if isAdmin();
    }
    match /ttc/mitgliederFinanzen {
      allow read, write: if isAdmin();
    }

    // ── Tippspiel: eigene Tipps sind geheim, bis der Admin sie freigibt ────
    // Jeder darf nur seine eigenen Tipps lesen/schreiben, solange
    // ttc/tippspiel.revealed nicht true ist. Danach dürfen alle alle Tipps lesen.
    match /ttc/tippspiel/tipps/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/ttc/tippspiel).data.revealed == true
      );
      allow write: if request.auth != null && request.auth.uid == uid;
    }

  }
}
